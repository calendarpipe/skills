#!/usr/bin/env bash
# Mock curl — writes each argument on its own line to MOCK_CURL_LOG, then prints
# a stub response shaped like the real one: body, newline, HTTP status.
# Override the whole thing with MOCK_CURL_RESPONSE.
: "${MOCK_CURL_LOG:?MOCK_CURL_LOG not set — did test_helper.setup_mock_curl run?}"
printf '%s\n' "$@" > "$MOCK_CURL_LOG"
DEFAULT_RESPONSE='{"ok":true}
200'
printf '%s' "${MOCK_CURL_RESPONSE:-$DEFAULT_RESPONSE}"
